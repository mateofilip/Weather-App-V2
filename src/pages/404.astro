---
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<main class="m-auto flex flex-1 items-center justify-center px-4 py-16">
		<div class="glass-surface flex flex-col items-center gap-3 rounded-3xl px-10 py-12 text-center">
			<p class="text-ink text-6xl font-semibold tracking-tighter">404</p>
			<h2 class="text-ink text-xl font-semibold">Page not found</h2>
			<p class="text-ink/60 text-sm">The page you're looking for doesn't exist.</p>
			<a
				href="/"
				class="glass-chip text-ink mt-2 rounded-full px-4 py-2 text-sm font-medium transition-all duration-200 ease-out hover:-translate-y-0.5 focus-visible:ring-ink/30 active:scale-95 focus-visible:ring-2 focus-visible:outline-none"
			>
				Back home
			</a>
		</div>
	</main>
</Layout>
